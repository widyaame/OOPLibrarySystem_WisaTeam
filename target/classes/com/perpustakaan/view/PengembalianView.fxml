<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.perpustakaan.controller.PengembalianController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <top>
      <VBox spacing="15.0">
         <children>
            <Label styleClass="page-title" text="Proses Pengembalian Buku" />
            <HBox spacing="10.0">
               <children>
                  <TextField fx:id="searchField" HBox.hgrow="ALWAYS" prefHeight="40.0" promptText="Masukkan NIM Anggota atau ISBN Buku..." styleClass="input-field" />
                  <Button fx:id="searchButton" onAction="#handleSearchButton" prefHeight="40.0" text="Cari" />
               </children>
            </HBox>
         </children>
         <BorderPane.margin>
            <Insets bottom="20.0" />
         </BorderPane.margin>
      </VBox>
   </top>
   <center>
      <TableView fx:id="peminjamanTableView" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="memberIdColumn" prefWidth="150.0" text="ID Anggota (NIM)" />
            <TableColumn fx:id="judulColumn" prefWidth="300.0" text="Judul Buku" />
            <TableColumn fx:id="tglKembaliColumn" prefWidth="150.0" text="Jatuh Tempo" />
            <TableColumn fx:id="dendaColumn" prefWidth="150.0" text="Denda Saat Ini" />
         </columns>
      </TableView>
   </center>
   <bottom>
      <VBox alignment="CENTER_RIGHT">
         <BorderPane.margin>
            <Insets top="20.0" />
         </BorderPane.margin>
         <Button fx:id="prosesButton" disable="true" mnemonicParsing="false" onAction="#handleProsesButton" prefHeight="40.0" prefWidth="250.0" styleClass="add-button" text="Proses Pengembalian Terpilih" />
      </VBox>
   </bottom>
</BorderPane>