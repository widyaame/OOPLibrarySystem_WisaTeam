<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.perpustakaan.controller.KelolaBukuController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <top>
      <Label styleClass="page-title" text="Kelola Katalog Buku">
         <BorderPane.margin>
            <Insets bottom="20.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <center>
      <TableView fx:id="bookTableView">
        <columns>
          <TableColumn fx:id="isbnColumn" prefWidth="120.0" text="ISBN" />
          <TableColumn fx:id="titleColumn" prefWidth="250.0" text="Judul" />
            <TableColumn fx:id="authorColumn" prefWidth="150.0" text="Penulis" />
            <TableColumn fx:id="categoryColumn" prefWidth="100.0" text="Kategori" />
            <TableColumn fx:id="statusColumn" prefWidth="100.0" text="Status" />
        </columns>
         <BorderPane.margin>
            <Insets />
         </BorderPane.margin>
      </TableView>
   </center>
   <right>
      <VBox styleClass="form-container" spacing="15.0">
         <BorderPane.margin>
            <Insets left="25.0" />
         </BorderPane.margin>
         <children>
            <Label styleClass="form-title" text="Detail Buku" />
            <GridPane hgap="10.0" vgap="15.0">
               <children>
                  <Label text="ISBN" />
                  <TextField fx:id="isbnField" styleClass="input-field" GridPane.columnIndex="1" />
                  <Label text="Judul" GridPane.rowIndex="1" />
                  <TextField fx:id="titleField" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  <Label text="Penulis" GridPane.rowIndex="2" />
                  <TextField fx:id="authorField" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="Kategori" GridPane.rowIndex="3" />
                  <TextField fx:id="categoryField" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="3" />
                  <Label text="Status" GridPane.rowIndex="4" />
                  <ComboBox fx:id="statusComboBox" maxWidth="1.7976931348623157E308" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="4" />
               </children>
            </GridPane>
            
            <HBox alignment="CENTER_LEFT" spacing="10.0">
               <children>
                  <Button fx:id="addButton" onAction="#handleAddButton" prefHeight="40.0" styleClass="add-button" text="Tambah">
                     <graphic>
                        <FontAwesomeIconView fill="white" glyphName="PLUS" />
                     </graphic>
                  </Button>
                  <Button fx:id="updateButton" onAction="#handleUpdateButton" prefHeight="40.0" text="Simpan">
                     <graphic>
                        <FontAwesomeIconView fill="white" glyphName="SAVE" />
                     </graphic>
                  </Button>
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="clearButton" onAction="#handleClearButton" styleClass="icon-button">
                     <graphic>
                        <FontAwesomeIconView glyphName="ERASER" size="1.5em" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="Bersihkan Form" />
                     </tooltip>
                  </Button>
                  <Button fx:id="deleteButton" onAction="#handleDeleteButton" styleClass="icon-button-delete">
                     <graphic>
                        <FontAwesomeIconView glyphName="TRASH" size="1.5em" />
                     </graphic>
                     <tooltip>
                        <Tooltip text="Hapus Buku" />
                     </tooltip>
                  </Button>
               </children>
               <VBox.margin>
                  <Insets top="20.0" />
               </VBox.margin>
            </HBox>
         </children>
      </VBox>
   </right>
</BorderPane>