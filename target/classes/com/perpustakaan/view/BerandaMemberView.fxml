<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.perpustakaan.controller.BerandaMemberController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <top>
      <VBox spacing="5.0" BorderPane.alignment="CENTER_LEFT">
         <children>
            <Label fx:id="welcomeLabel" styleClass="page-title" text="Selamat Datang!" />
            <Label text="Berikut adalah ringkasan aktivitas perpustakaan Anda." styleClass="page-subtitle" />
         </children>
         <BorderPane.margin>
            <Insets bottom="20.0" />
         </BorderPane.margin>
      </VBox>
   </top>
   <center>
      <VBox spacing="20.0">
         <children>
            <HBox spacing="20.0">
               <children>
                  <VBox alignment="CENTER" styleClass="form-container" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="bukuDipinjamLabel" styleClass="stats-number" text="0" />
                        <Label styleClass="stats-label" text="Buku Sedang Dipinjam" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" styleClass="form-container" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="totalPinjamLabel" styleClass="stats-number" text="0" />
                        <Label styleClass="stats-label" text="Total Riwayat Pinjam" />
                     </children>
                  </VBox>
                  <VBox alignment="CENTER" styleClass="form-container" HBox.hgrow="ALWAYS">
                     <children>
                        <Label fx:id="bukuTerlambatLabel" styleClass="stats-number" text="0" />
                        <Label styleClass="stats-label" text="Buku Terlambat" />
                     </children>
                  </VBox>
               </children>
            </HBox>
            <HBox fx:id="notifikasiBox" alignment="CENTER_LEFT" managed="false" spacing="15.0" styleClass="notifikasi-terlambat" visible="false">
               <children>
                  <FontAwesomeIconView glyphName="WARNING" size="2em" />
                  <Label fx:id="notifikasiLabel" text="Anda memiliki buku yang sudah melewati jatuh tempo pengembalian!" />
               </children>
            </HBox>
         </children>
      </VBox>
   </center>
</BorderPane>