<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ChoiceBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.perpustakaan.controller.KatalogBukuController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <top>
      <VBox spacing="15.0">
         <children>
            <Label styleClass="page-title" text="Katalog Buku" />
            <TextField fx:id="searchField" prefHeight="40.0" promptText="Cari buku berdasarkan judul atau penulis..." styleClass="input-field" />
         </children>
         <BorderPane.margin>
            <Insets bottom="20.0" />
         </BorderPane.margin>
      </VBox>
   </top>
   <center>
      <TableView fx:id="bookTableView">
         <columns>
            <TableColumn fx:id="isbnColumn" prefWidth="120.0" text="ISBN" />
            <TableColumn fx:id="titleColumn" prefWidth="300.0" text="Judul" />
            <TableColumn fx:id="authorColumn" prefWidth="200.0" text="Penulis" />
            <TableColumn fx:id="categoryColumn" prefWidth="120.0" text="Kategori" />
         </columns>
      </TableView>
   </center>
   <right>
      <VBox styleClass="form-container" spacing="15.0">
         <BorderPane.margin>
            <Insets left="25.0" />
         </BorderPane.margin>
         <children>
            <Label styleClass="form-title" text="Detail Peminjaman" />
            <GridPane hgap="10.0" vgap="10.0">
               <children>
                  <Label text="Judul:" />
                  <Label fx:id="titleLabel" style="-fx-font-weight: bold;" text="-" wrapText="true" GridPane.columnIndex="1" />
                  <Label text="Penulis:" GridPane.rowIndex="1" />
                  <Label fx:id="authorLabel" style="-fx-font-weight: bold;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                  
                  <Label text="Durasi Pinjam:" GridPane.rowIndex="2" />
                  <ChoiceBox fx:id="durasiChoiceBox" maxWidth="1.7976931348623157E308" styleClass="input-field" GridPane.columnIndex="1" GridPane.rowIndex="2" />
                  <Label text="Jatuh Tempo:" GridPane.rowIndex="3" />
                  <Label fx:id="dueDateLabel" style="-fx-font-weight: bold;" text="-" GridPane.columnIndex="1" GridPane.rowIndex="3" />
               </children>
            </GridPane>
            <Label styleClass="fine-info-label" text="*Denda keterlambatan: Rp 1.000 per hari." wrapText="true" />
            <Button fx:id="borrowButton" disable="true" mnemonicParsing="false" onAction="#handleBorrowButton" prefHeight="40.0" prefWidth="250.0" styleClass="add-button" text="Pinjam Buku Ini" />
         </children>
      </VBox>
   </right>
</BorderPane>