<?xml version="1.0" encoding="UTF-8"?>

<?import de.jensd.fx.glyphs.fontawesome.FontAwesomeIconView?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.perpustakaan.controller.ProfilController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <top>
      <VBox alignment="CENTER_LEFT" spacing="10.0" BorderPane.alignment="CENTER_LEFT">
         <children>
            <Label fx:id="welcomeLabel" styleClass="page-title" text="Profil Saya" />
            <Label fx:id="memberIdHeaderLabel" styleClass="page-subtitle" text="ID Anggota:" />
         </children>
         <BorderPane.margin>
            <Insets bottom="20.0" />
         </BorderPane.margin>
      </VBox>
   </top>
   <center>
      <HBox alignment="TOP_LEFT" spacing="30.0">
         <children>
            <VBox styleClass="form-container" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="form-title" text="Identitas Diri" />
                  <VBox styleClass="info-section">
                     <children>
                        <FontAwesomeIconView glyphName="USER" styleClass="info-icon" />
                        <VBox>
                           <Label styleClass="info-label" text="Nama Lengkap" />
                           <Label fx:id="fullNameLabel" styleClass="info-data" text="-" />
                        </VBox>
                     </children>
                  </VBox>
                  <VBox styleClass="info-section">
                     <children>
                        <FontAwesomeIconView glyphName="ID_CARD" styleClass="info-icon" />
                        <VBox>
                           <Label styleClass="info-label" text="Jurusan" />
                           <Label fx:id="majorLabel" styleClass="info-data" text="-" />
                        </VBox>
                     </children>
                  </VBox>
               </children>
            </VBox>
            <VBox styleClass="form-container" HBox.hgrow="ALWAYS">
               <children>
                  <Label styleClass="form-title" text="Pengaturan Akun" />
                  <VBox spacing="10.0">
                     <VBox.margin>
                        <Insets top="15.0" />
                     </VBox.margin>
                     <children>
                        <Label text="Email" />
                        <TextField fx:id="emailField" styleClass="input-field" />
                     </children>
                  </VBox>
                  <StackPane alignment="TOP_CENTER">
                     <children>
                        <Hyperlink fx:id="ubahPinLink" onAction="#handleUbahPinLink" text="Ubah PIN" />
                        <VBox fx:id="pinContainer" alignment="TOP_LEFT" managed="false" spacing="15.0" styleClass="pin-container" visible="false">
                           <children>
                              <Label style="-fx-font-weight: bold;" text="Perbarui PIN Keamanan Anda" />
                              <VBox spacing="10.0">
                                 <children>
                                    <Label text="PIN Baru" />
                                    <PasswordField fx:id="pinField" promptText="Masukkan PIN baru" styleClass="input-field" />
                                 </children>
                              </VBox>
                              <VBox spacing="10.0">
                                 <children>
                                    <Label text="Konfirmasi PIN" />
                                    <PasswordField fx:id="konfirmasiPinField" promptText="Ulangi PIN baru" styleClass="input-field" />
                                 </children>
                              </VBox>
                           </children>
                        </VBox>
                     </children>
                  </StackPane>
                  <Button fx:id="simpanButton" onAction="#handleSimpanButton" maxWidth="1.7976931348623157E308" prefHeight="40.0" text="Simpan Perubahan">
                     <graphic>
                        <FontAwesomeIconView fill="white" glyphName="SAVE" />
                     </graphic>
                     <VBox.margin>
                        <Insets top="20.0" />
                     </VBox.margin>
                  </Button>
               </children>
            </VBox>
         </children>
      </HBox>
   </center>
</BorderPane>