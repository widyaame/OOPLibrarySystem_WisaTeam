<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="content-area" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.perpustakaan.controller.BukuSayaController">
   <padding>
      <Insets bottom="25.0" left="25.0" right="25.0" top="25.0" />
   </padding>
   <top>
      <Label styleClass="page-title" text="Buku yang Sedang Dipinjam" BorderPane.alignment="CENTER_LEFT">
         <BorderPane.margin>
            <Insets bottom="20.0" />
         </BorderPane.margin>
      </Label>
   </top>
   <center>
      <TableView fx:id="pinjamanTableView" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="judulColumn" prefWidth="350.0" text="Judul Buku" />
            <TableColumn fx:id="tglPinjamColumn" prefWidth="150.0" text="Tanggal Pinjam" />
            <TableColumn fx:id="tglKembaliColumn" prefWidth="150.0" text="Jatuh Tempo" />
            <TableColumn fx:id="terlambatColumn" prefWidth="120.0" text="Terlambat" />
            <TableColumn fx:id="dendaColumn" prefWidth="120.0" text="Denda" />
         </columns>
      </TableView>
   </center>
</BorderPane>